{
  "name": "gitbash-mcp",
  "version": "2.4.1",
  "description": "MCP server that exposes git-bash (MSYS2) command execution to AI agents such as DSH, Claude Code and Codex.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "gitbash-mcp": "bin/gitbash-mcp.js"
  },
  "files": [
    "bin/",
    "lib/",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git-bash",
    "bash",
    "msys2",
    "windows",
    "shell",
    "dsh"
  ],
  "scripts": {
    "start": "node bin/gitbash-mcp.js",
    "test": "node test/test-client.mjs && node test/test-cli.mjs && node test/test-menu.mjs && node test/test-runner.mjs && node test/test-policy.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}